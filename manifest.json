{
  "manifest_version": 3,
  "name": "iloxx Autofill",
  "version": "1.3.0",
  "minimum_chrome_version": "99",
  "description": "Befuellt das iloxx-Versandformular mit Bestelldaten aus einer konfigurierbaren Shop-API. Inoffiziell, nicht mit iloxx verbunden.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "host_permissions": [
    "https://www.iloxx.de/*",
    "https://iloxx.de/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.iloxx.de/*",
        "https://iloxx.de/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
